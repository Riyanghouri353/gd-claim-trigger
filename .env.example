# Copy to .env (local dev only). On Render, set these in the dashboard → Environment.
# NEVER commit real private keys to git.

# JSON array of wallets. "chains" per wallet is optional (defaults to CHAINS).
WALLETS_JSON=[{"label":"Wallet 1","privateKey":"0xYOUR_KEY_1"},{"label":"Wallet 2","privateKey":"0xYOUR_KEY_2"}]

# Chains to claim when a wallet has no per-wallet override
CHAINS=celo,xdc,fuse

# gd-claim function (defaults are already correct; override only if it moves)
GD_CLAIM_URL=https://uiwsjxfcdruvqnbgdwdd.supabase.co/functions/v1/gd-claim

# Daily scheduled run time, HH:MM in UTC
CLAIM_TIME_UTC=18:00
