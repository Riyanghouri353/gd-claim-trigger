# Copy to .env (local dev only). On Render, set these in the dashboard → Environment.
# NEVER commit real keys to git.

# Encrypted wallet vault
SUPABASE_URL=https://jmayjkfhmjqcxzsjyzyw.supabase.co
SUPABASE_SERVICE_KEY=<service_role key from Supabase dashboard → Project Settings → API>
PROJECT_KEY=<64-hex key you generated — same one used to encrypt the wallets>

# Chains to claim when a wallet row has no per-wallet override
CHAINS=celo,xdc,fuse

# gd-claim function (defaults are already correct; override only if it moves)
GD_CLAIM_URL=https://uiwsjxfcdruvqnbgdwdd.supabase.co/functions/v1/gd-claim

# Daily scheduled run time, HH:MM in UTC
CLAIM_TIMES_UTC=14:00,18:00,22:00

# Fee guard: top up CELO via the GoodDollar faucet when a wallet's balance is below this
FEE_THRESHOLD_CELO=0.14

# --- Riyan Agent (/agent) ---
# SUPABASE_URL + SUPABASE_SERVICE_KEY above are reused (same project).
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
# Encrypts Groq API keys at rest. NEVER change after adding keys.
VAULT_KEY=
# 32+ random chars for the agent login session cookie
SESSION_SECRET=
# Random string protecting /api/agent/cron/* (cron-job.org sends as Bearer)
CRON_SECRET=
